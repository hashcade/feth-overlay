CXX ?= c++
CXXFLAGS ?= -std=c++20 -Wall -Wextra -Werror -pedantic -O2

HOST_BUILD := .build-host
CORE_SOURCES := source/core/catalog.cpp source/core/engine.cpp source/core/items.cpp source/generated/item_data.cpp source/core/battalions.cpp source/generated/battalion_catalog.cpp source/core/abilities.cpp source/core/classes.cpp source/generated/class_catalog.cpp source/core/supports.cpp source/generated/support_catalog.cpp
LOCALIZATION_SOURCES := source/core/locale.cpp source/core/messages.cpp source/generated/names.cpp

.PHONY: test clean-host

test: $(HOST_BUILD)/core-tests $(HOST_BUILD)/localization-tests $(HOST_BUILD)/model-tests $(HOST_BUILD)/durability-session-tests $(HOST_BUILD)/sound-tests
	@$(HOST_BUILD)/core-tests
	@$(HOST_BUILD)/localization-tests
	@$(HOST_BUILD)/model-tests
	@$(HOST_BUILD)/durability-session-tests
	@$(HOST_BUILD)/sound-tests

$(HOST_BUILD)/sound-tests: source/core/sound.cpp tests/sound_tests.cpp include/feth/core/sound.hpp
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude source/core/sound.cpp tests/sound_tests.cpp -o $@

$(HOST_BUILD)/durability-session-tests: source/core/durability_session.cpp source/generated/item_data.cpp tests/durability_session_tests.cpp $(wildcard include/feth/core/*.hpp)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude source/core/durability_session.cpp source/generated/item_data.cpp tests/durability_session_tests.cpp -o $@

$(HOST_BUILD)/core-tests: $(CORE_SOURCES) tests/core_tests.cpp $(wildcard include/feth/core/*.hpp)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(CORE_SOURCES) tests/core_tests.cpp -o $@

$(HOST_BUILD)/localization-tests: $(LOCALIZATION_SOURCES) source/core/catalog.cpp tests/localization_tests.cpp $(wildcard include/feth/core/*.hpp)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(LOCALIZATION_SOURCES) source/core/catalog.cpp tests/localization_tests.cpp -o $@

$(HOST_BUILD)/model-tests: source/app/model.cpp source/core/locale.cpp source/core/messages.cpp tests/model_tests.cpp $(wildcard include/feth/core/*.hpp) $(wildcard include/feth/app/*.hpp)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude source/app/model.cpp source/core/locale.cpp source/core/messages.cpp tests/model_tests.cpp -o $@

clean-host:
	rm -rf $(HOST_BUILD)
